[tool] bash
$ cd /tmp && python3 - <<'EOF'
import re, html
raw = open('gadda.html', encoding='utf-8').read()
raw = re.sub(r'<(script|style)[^>]*>.*?</\1>', '', raw, flags=re.S)
# locate Opere section start
i = raw.find('>Opere<')
if i == -1:
    # try heading with id
    m = re.search(r'id="Opere"', raw)
    i = m.start() if m else -1
print('start idx', i)
seg = raw[i:i+12000]
# remove tags but keep list markers
seg = re.sub(r'<li[^>]*>', '\n- ', seg)
seg = re.sub(r'</li>', '', seg)
seg = re.sub(r'<h([23])[^>]*>', '\n\n## ', seg)
seg = re.sub(r'<[^>]+>', '', seg)
seg = html.unescape(seg)
seg = re.sub(r'\[\d+\]', '', seg)
lines = [l.strip() for l in seg.splitlines()]
out = []
for l in lines:
    if l and not l.startswith('## ') or l.startswith('## '):
        out.append(l)
print('\n'.join(out[:200]))
