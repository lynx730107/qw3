[tool] bash
$ python3 - <<'EOF'
import re, html
raw = open('/tmp/gadda.html', encoding='utf-8').read()
# strip scripts/styles
raw = re.sub(r'<(script|style)[^>]*>.*?</\1>', '', raw, flags=re.S)
# mark headings
raw = re.sub(r'<h([1-6])[^>]*>', lambda m: '\n\n@@H%s ' % m.group(1), raw)
raw = re.sub(r'</h[1-6]>', '\n', raw)
raw = re.sub(r'<li[^>]*>', '\n- ', raw)
raw = re.sub(r'<p[^>]*>', '\n', raw)
text = re.sub(r'<[^>]+>', '', raw)
text = html.unescape(text)
lines = [l.strip() for l in text.split('\n')]
out = []
for l in lines:
    if l:
        out.append(l)
open('/tmp/gadda.txt','w',encoding='utf-8').write('\n'.join(out))
print(len(out))
EOF
