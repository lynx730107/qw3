import re, html
with open('/tmp/gadda.html', encoding='utf-8') as f:
    content = f.read()
# The Opere section starts at 127310. Let's find where it ends (next major h2).
# Look for the next section heading after 127310
seg = content[127310:]
# Find headings like <h2 ...> or mw-heading
m = re.search(r'<h2[^>]*id="mwBc"', seg)
# Instead, let's just take a big chunk and extract list items
chunk = content[127310:135000]
# Extract all list items
items = re.findall(r'<li[^>]*>(.*?)</li>', chunk, re.DOTALL)
for it in items:
