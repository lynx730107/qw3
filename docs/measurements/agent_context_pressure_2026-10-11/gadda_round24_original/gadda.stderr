[tool] bash
$ python3 << 'EOF'
import re
html = open('/tmp/gadda.html', encoding='utf-8').read()
start = html.find('id="Opere"')
next_h2 = re.search(r'<h2[^>]*>', html[start+10:])
end = start + 10 + next_h2.start() if next_h2 else len(html)
section = html[start:end]

# Find subsection headings (h3) and their positions
h3s = [(m.start(), m.group(1)) for m in re.finditer(r'<h3[^>]*>(.*?)</h3>', section, re.DOTALL)]
print("Subsections:")
for pos, title in h3s:
    clean = re.sub(r'<[^>]+>', '', title).strip()
    print(f"  [{pos}] {clean}")

# Now extract items grouped by subsection
items = re.findall(r'<li>(.*?)</li>', section, re.DOTALL)
print(f"\nTotal list items: {len(items)}")
print("\n--- ALL ITEMS ---")
for i, item in enumerate(items):
    clean = re.sub(r'<[^>]+>', '', item).strip()
    clean = re.sub(r'\s+', ' ', clean)
    print(f"{i+1}. {clean}")
EOF
