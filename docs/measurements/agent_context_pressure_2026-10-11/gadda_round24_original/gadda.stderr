$ python3 - <<'EOF'
import re, html
with open('/tmp/gadda.html', encoding='utf-8') as f:
    content = f.read()
# Find all h2/h3 headings with their positions to map sections
for m in re.finditer(r'<h([23])[^>]*>(.*?)</h\1>', content, re.DOTALL):
    txt = re.sub(r'<[^>]+>','',m.group(2))
    txt = html.unescape(txt).strip()
    print(m.start(), m.group(1), txt)
