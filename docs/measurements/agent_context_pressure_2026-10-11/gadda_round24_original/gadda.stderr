[tool] bash
$ python3 << 'EOF'
import re
html = open('/tmp/gadda.html', encoding='utf-8').read()
start = html.find('id="Opere"')
next_h2 = re.search(r'<h2[^>]*>', html[start+10:])
end = start + 10 + next_h2.start() if next_h2 else len(html)
section = html[start:end]

# Subsection boundaries
h3s = [(m.start(), re.sub(r'<[^>]+>', '', m.group(1)).strip()) for m in re.finditer(r'<h3[^>]*>(.*?)</h3>', section, re.DOTALL)]
h3s.append((len(section), None))

for i in range(len(h3s)-1):
    s_start, s_title = h3s[i]
    s_end = h3s[i+1][0]
    sub = section[s_start:s_end]
    items = re.findall(r'<li>(.*?)</li>', sub, re.DOTALL)
    print(f"\n=== {s_title} ===")
    for item in items:
        clean = re.sub(r'<[^>]+>', '', item).strip()
        clean = re.sub(r'\s+', ' ', clean)
        print(f"  - {clean}")
EOF

