+int qw3_engine_set_weights_active(qw3_engine *e, bool active) {
+    if (!e) return -1;
+#ifndef QW3_NO_METAL
+    if (e->backend == QW3_BACKEND_METAL) {
+        if (!e->metal_ready) return -1;
+        if (active == e->metal_weights_active) return 0;
+        int ok;
+        if (!active) ok = qw3_metal_release_model_views();
+        else {
+            uint64_t offset = e->model.tensor_data_offset;
+            ok = qw3_metal_set_model_map_range(e->model.map, e->model.map_size,
+                                              offset, e->model.map_size - offset);
+        }
+        if (ok) e->metal_weights_active = active;
+        return ok ? 0 : -1;
+    }
+#else
+    (void)active;
+#endif
+    return 0;
+}
